{
  "name": "qwen-dap-mcp",
  "version": "0.10.0",
  "description": "A small DAP-to-MCP bridge for agentic runtime debugging, designed to work with Qwen Code and other MCP clients.",
  "type": "module",
  "bin": {
    "qwen-dap-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "qwen-extension.json",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "test:codelldb:real": "tsx test/codelldb-real-smoke.ts",
    "test:codelldb:dump": "tsx test/codelldb-real-dump-smoke.ts",
    "package:extension": "node scripts/build-extension-package.mjs",
    "check": "npm run build && npm test && npm run package:extension",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dap",
    "debug-adapter-protocol",
    "debugger",
    "codelldb",
    "lldb",
    "core-dump",
    "minidump",
    "postmortem-debugging",
    "qwen-code",
    "qwen-extension",
    "agentic-debugging"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vscode/debugprotocol": "^1.68.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
